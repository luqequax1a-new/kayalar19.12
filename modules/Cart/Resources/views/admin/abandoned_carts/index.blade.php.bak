@push('scripts')
    <script src="https://cdn.datatables.net/1.13.4/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.4/js/dataTables.bootstrap.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@3.9.1/dist/chart.min.js"></script>
    <script>
        $(document).ready(function() {
            // DataTable
            $('#abandoned-carts-table').DataTable({
                processing: true,
                serverSide: true,
                ajax: '{{ route("admin.abandoned_carts.index") }}?table=true',
                columns: [
                    { data: 'customer_name', name: 'customer_name' },
                    { data: 'customer_email', name: 'customer_email' },
                    { data: 'items_count', name: 'items_count', searchable: false },
                    { data: 'is_recovered', name: 'is_recovered' },
                    { data: 'is_clicked', name: 'is_clicked' },
                    { data: 'reminder_count', name: 'reminder_count', searchable: false },
                    { data: 'updated_at', name: 'updated_at' },
                    { data: 'actions', name: 'actions', orderable: false, searchable: false }
                ],
                order: [[6, 'desc']],
                pageLength: 25,
                language: {
                    url: '//cdn.datatables.net/plug-ins/1.10.24/i18n/Turkish.json'
                },
                drawCallback: function() {
                    $('.badge').addClass('badge-modern');
                }
            });

            // Chart
            const ctx = document.getElementById('abandonedCartChart').getContext('2d');
            
            fetch('{{ route("admin.abandoned_carts.index") }}?chart=true')
                .then(response => response.json())
                .then(data => {
                    new Chart(ctx, {
                        type: 'line',
                        data: {
                            labels: data.labels,
                            datasets: [
                                {
                                    label: 'Terk Edilen',
                                    data: data.abandoned,
                                    borderColor: '#f39c12',
                                    backgroundColor: 'rgba(243, 156, 18, 0.08)',
                                    borderWidth: 3,
                                    tension: 0.4,
                                    fill: true,
                                    pointRadius: 6,
                                    pointHoverRadius: 8,
                                    pointBackgroundColor: '#f39c12',
                                    pointBorderColor: '#fff',
                                    pointBorderWidth: 3,
                                    pointHoverBackgroundColor: '#fff',
                                    pointHoverBorderColor: '#f39c12',
                                    pointHoverBorderWidth: 3
                                },
                                {
                                    label: 'Kurtarılan',
                                    data: data.recovered,
                                    borderColor: '#00a65a',
                                    backgroundColor: 'rgba(0, 166, 90, 0.08)',
                                    borderWidth: 3,
                                    tension: 0.4,
                                    fill: true,
                                    pointRadius: 6,
                                    pointHoverRadius: 8,
                                    pointBackgroundColor: '#00a65a',
                                    pointBorderColor: '#fff',
                                    pointBorderWidth: 3,
                                    pointHoverBackgroundColor: '#fff',
                                    pointHoverBorderColor: '#00a65a',
                                    pointHoverBorderWidth: 3
                                }
                            ]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: true,
                            plugins: {
                                legend: {
                                    display: false
                                },
                                tooltip: {
                                    backgroundColor: 'rgba(44, 62, 80, 0.95)',
                                    padding: 16,
                                    titleFont: { size: 15, weight: 'bold' },
                                    bodyFont: { size: 14 },
                                    cornerRadius: 12,
                                    displayColors: true,
                                    boxWidth: 12,
                                    boxHeight: 12,
                                    boxPadding: 6
                                }
                            },
                            scales: {
                                y: {
                                    beginAtZero: true,
                                    ticks: {
                                        precision: 0,
                                        font: { size: 13, weight: '500' },
                                        color: '#7f8c8d',
                                        padding: 10
                                    },
                                    grid: {
                                        color: 'rgba(0,0,0,0.04)',
                                        drawBorder: false
                                    }
                                },
                                x: {
                                    ticks: {
                                        font: { size: 13, weight: '500' },
                                        color: '#7f8c8d',
                                        padding: 10
                                    },
                                    grid: {
                                        display: false,
                                        drawBorder: false
                                    }
                                }
                            },
                            interaction: {
                                intersect: false,
                                mode: 'index'
                            }
                        }
                    });
                });

            // Send Reminder Handler
            $(document).on('click', '.send-reminder-btn', function(e) {
                e.preventDefault();
                
                var btn = $(this);
                var cartId = btn.data('cart-id');
                
                if (!confirm('Bu sepet için hatırlatma e-postası göndermek istediğinize emin misiniz?')) {
                    return;
                }
                
                btn.prop('disabled', true).html('<i class="fa fa-spinner fa-spin"></i>');
                
                $.ajax({
                    url: '/admin/abandoned-carts/' + cartId + '/send-reminder',
                    type: 'POST',
                    headers: {
                        'X-CSRF-TOKEN': $('meta[name="csrf-token"]').attr('content')
                    },
                    success: function(response) {
                        if (response.success) {
                            alert(response.message);
                            $('#abandoned-carts-table').DataTable().ajax.reload();
                        } else {
                            alert('Hata: ' + response.message);
                        }
                    },
                    error: function(xhr) {
                        var message = 'Bir hata oluştu!';
                        if (xhr.responseJSON && xhr.responseJSON.message) {
                            message = xhr.responseJSON.message;
                        }
                        alert(message);
                    },
                    complete: function() {
                        btn.prop('disabled', false).html('<i class="fa fa-envelope"></i>');
                    }
                });
            });
        });
    </script>
@endpush
