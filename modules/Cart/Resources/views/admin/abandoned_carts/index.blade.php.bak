@push('scripts')
<script src="https://cdn.jsdelivr.net/npm/chart.js@3.9.1/dist/chart.min.js"></script>
<script>
$(document).ready(function() {
    let currentPage = 1;
    let totalPages = 1;

    function loadCarts(page = 1) {
        const listContainer = $('#carts-list');
        listContainer.html('<div class="loading-overlay"><div class="spinner"></div></div>');

        $.ajax({
            url: '{{ route("admin.abandoned_carts.index") }}',
            data: {
                table: true,
                start: (page - 1) * 25,
                length: 25
            },
            success: function(response) {
                renderCarts(response.data);
                updatePagination(response.recordsFiltered, page);
            },
            error: function() {
                listContainer.html(`
                    <div class="empty-state">
                        <div class="empty-state-icon"><i class="fa fa-exclamation-triangle"></i></div>
                        <div class="empty-state-title">Hata Oluştu</div>
                        <div class="empty-state-text">Sepetler yüklenirken bir hata oluştu.</div>
                    </div>
                `);
            }
        });
    }

    function renderCarts(carts) {
        const listContainer = $('#carts-list');
        
        if (carts.length === 0) {
            listContainer.html(`
                <div class="empty-state">
                    <div class="empty-state-icon"><i class="fa fa-shopping-cart"></i></div>
                    <div class="empty-state-title">Henüz Terk Edilmiş Sepet Yok</div>
                    <div class="empty-state-text">Müşteriler sepetlerini terk ettiğinde burada görünecekler.</div>
                </div>
            `);
            return;
        }

        let html = '';
        carts.forEach(cart => {
            const customerName = cart.customer_name || '-';
            const customerEmail = cart.customer_email || '-';
            const itemsCount = cart.items_count || 0;
            const date = cart.updated_at || '-';

            html += `
                <div class="cart-card">
                    <div class="cart-field">
                        <div class="cart-field-label">Müşteri</div>
                        <div class="customer-info">
                            <div class="customer-name">${customerName}</div>
                        </div>
                    </div>

                    <div class="cart-field">
                        <div class="cart-field-label">E-posta</div>
                        <div class="customer-email">${customerEmail}</div>
                    </div>

                    <div class="cart-field">
                        <div class="cart-field-label">Ürünler</div>
                        <div class="items-count">
                            <i class="fa fa-shopping-bag"></i>
                            ${itemsCount}
                        </div>
                    </div>

                    <div class="cart-field">
                        <div class="cart-field-label">Durum</div>
                        ${cart.is_recovered}
                    </div>

                    <div class="cart-field">
                        <div class="cart-field-label">Tıklama</div>
                        ${cart.is_clicked}
                    </div>

                    <div class="cart-field">
                        <div class="cart-field-label">Hatırlatma</div>
                        ${cart.reminder_count}
                    </div>

                    <div class="cart-field">
                        <div class="cart-field-label">Tarih</div>
                        <div class="date-display">${date}</div>
                    </div>

                    <div class="cart-field">
                        <div class="cart-field-label">İşlemler</div>
                        ${cart.actions}
                    </div>
                </div>
            `;
        });

        listContainer.html(html);
    }

    function updatePagination(total, currentPage) {
        const perPage = 25;
        totalPages = Math.ceil(total / perPage);
        
        if (totalPages <= 1) {
            $('#pagination-container').hide();
            return;
        }

        $('#pagination-container').show();
        
        const start = ((currentPage - 1) * perPage) + 1;
        const end = Math.min(currentPage * perPage, total);
        $('#showing-text').text(`${start}-${end} / ${total} sepet gösteriliyor`);

        let paginationHtml = '';
        
        // Previous button
        paginationHtml += `
            <li class="${currentPage === 1 ? 'disabled' : ''}">
                <a href="#" data-page="${currentPage - 1}">
                    <i class="fa fa-chevron-left"></i>
                </a>
            </li>
        `;

        // Page numbers
        for (let i = 1; i <= totalPages; i++) {
            if (i === 1 || i === totalPages || (i >= currentPage - 2 && i <= currentPage + 2)) {
                paginationHtml += `
                    <li class="${i === currentPage ? 'active' : ''}">
                        <a href="#" data-page="${i}">${i}</a>
                    </li>
                `;
            } else if (i === currentPage - 3 || i === currentPage + 3) {
                paginationHtml += '<li class="disabled"><span>...</span></li>';
            }
        }

        // Next button
        paginationHtml += `
            <li class="${currentPage === totalPages ? 'disabled' : ''}">
                <a href="#" data-page="${currentPage + 1}">
                    <i class="fa fa-chevron-right"></i>
                </a>
            </li>
        `;

        $('#pagination').html(paginationHtml);
    }

    // Pagination click handler
    $(document).on('click', '#pagination a', function(e) {
        e.preventDefault();
        const page = parseInt($(this).data('page'));
        if (page >= 1 && page <= totalPages) {
            currentPage = page;
            loadCarts(page);
            $('html, body').animate({ scrollTop: $('.carts-container').offset().top - 100 }, 300);
        }
    });

    // Send Reminder Handler
    $(document).on('click', '.send-reminder-btn', function(e) {
        e.preventDefault();
        
        var btn = $(this);
        var cartId = btn.data('cart-id');
        
        if (!confirm('Bu sepet için hatırlatma e-postası göndermek istediğinize emin misiniz?')) {
            return;
        }
        
        btn.prop('disabled', true).html('<i class="fa fa-spinner fa-spin"></i>');
        
        $.ajax({
            url: '/admin/abandoned-carts/' + cartId + '/send-reminder',
            type: 'POST',
            headers: {
                'X-CSRF-TOKEN': $('meta[name="csrf-token"]').attr('content')
            },
            success: function(response) {
                if (response.success) {
                    alert(response.message);
                    loadCarts(currentPage);
                } else {
                    alert('Hata: ' + response.message);
                }
            },
            error: function(xhr) {
                var message = 'Bir hata oluştu!';
                if (xhr.responseJSON && xhr.responseJSON.message) {
                    message = xhr.responseJSON.message;
                }
                alert(message);
            },
            complete: function() {
                btn.prop('disabled', false).html('<i class="fa fa-envelope"></i>');
            }
        });
    });

    // Initial load
    loadCarts(1);
});
</script>
@endpush


